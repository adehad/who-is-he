{
  "name": "who-is-he",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build && bun scripts/sw.ts",
    "preview": "bun --bun astro preview",
    "check:types": "bun --bun astro check",
    "check": "bun --bun astro check && bun scripts/check.ts",
    "check:dist": "bun scripts/check.ts --dist",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "bun test",
    "icons": "bunx --bun pwa-assets-generator --config pwa-assets.config.ts && mkdir -p public/icons && mv assets/*.png assets/favicon.ico public/icons/",
    "images": "bun scripts/images.ts"
  },
  "dependencies": {
    "@fontsource/amiri": "5.3.0",
    "@fontsource/aref-ruqaa": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/baloo-2": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "@vite-pwa/assets-generator": "2.0.0",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "workbox-build": "7.4.1"
  }
}
