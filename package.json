{
  "name": "who-is-he",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "check:types": "bun --bun astro check",
    "check": "bun --bun astro check && bun scripts/check.ts",
    "check:dist": "bun scripts/check.ts --dist",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "bun test",
    "og": "bun scripts/og.ts"
  },
  "dependencies": {
    "@fontsource/amiri": "5.3.0",
    "@fontsource/aref-ruqaa": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/baloo-2": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3"
  }
}
