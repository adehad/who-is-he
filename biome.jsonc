{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "astro.config.mjs",
      "pwa-assets.config.ts",
      "biome.jsonc",
      "tsconfig.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "lineEnding": "lf", "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      // Biome only sees the frontmatter of .astro files, so template usage looks "unused".
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" }
        }
      }
    },
    {
      // Concept CSS is ported verbatim: !important is used for reduced-motion, ordering is deliberate.
      "includes": ["src/styles/global.css"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    }
  ]
}
