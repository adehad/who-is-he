---
import ShareCard from "@/components/ShareCard.astro";
import { STATIONS } from "@/data/stations";
import "@/styles/fonts";
import "@/styles/global.css";

export function getStaticPaths() {
  return STATIONS.map((s) => ({ params: { id: s.id }, props: { station: s } }));
}
const { station } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
<head><meta charset="utf-8"><meta name="robots" content="noindex"><title>share {station.id}</title></head>
<body style="margin:0;padding:0;min-height:0;background:var(--bg)"><ShareCard station={station} /></body>
</html>
