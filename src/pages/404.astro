---
import Base from "@/layouts/Base.astro";
import { stationMeta } from "@/lib/meta";

// Served by GitHub Pages and Cloudflare (not_found_handling = "404-page") for unknown URLs.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const meta = {
  ...stationMeta(0),
  title: "Page not found · Little Hilya",
  description: "This page does not exist. Start the walk or read the story instead.",
};
---
<Base meta={meta}>
  <div class="wrap">
    <header class="top">
      <div class="brand"><h1>Little Hilya</h1><span lang="ar">حِلْيَة</span></div>
    </header>
    <section class="hilya">
      <div class="hilya-inner">
        <h2 class="kid-title">We could not find that page</h2>
        <p class="kid-line">It may have moved, or the link has a typo.</p>
        <p class="kid-line"><a href={base}>Walk head to toe</a> · <a href={`${base}story/`}>Read the story</a></p>
      </div>
    </section>
  </div>
</Base>
